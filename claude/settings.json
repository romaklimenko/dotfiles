{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "enabledPlugins": {},
  "permissions": {
    "deny": [
      "Read(*.env)",
      "Bash(rm:*)",
      "Bash(curl:*)"
    ],
    "defaultMode": "default"
  },
  "respectGitignore": true,
  "spinnerVerbs": {
    "mode": "append",
    "verbs": [
      "Backstaging",
      "Ultrathinking"
    ]
  }
}